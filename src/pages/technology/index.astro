---
import Base from '../../layouts/Base.astro';
const lanes = [
  {title:'Power + batteries', kicker:'Energy', body:'Home batteries, portable power, charging, solar, energy monitoring and the infrastructure that keeps increasingly electric lives running.', status:'Affiliate research active'},
  {title:'Cars + mobility', kicker:'Move', body:'Electric vehicles, personal electric mobility, charging, vehicle technology, autonomy and the products that connect transportation to the rest of the machine.', status:'Affiliate research active'},
  {title:'Smart home', kicker:'Live', body:'Lighting, security, cleaning, sensors, access, Matter devices and practical automation that can make a home more responsive.', status:'Affiliate research active'},
  {title:'AI + computing', kicker:'Think', body:'AI systems, edge computing, maker electronics, sensors and the software and hardware that give machines perception and intelligence.', status:'Editorial build'},
  {title:'Tools + making', kicker:'Build', body:'Electronics, fabrication, prototyping, measurement and maker technology for people who want to create rather than merely consume the future.', status:'Editorial build'},
  {title:'Robots', kicker:'Act', body:'Humanoids, quadrupeds, service robots, logistics, cleaning, care, safety and machines that increasingly act in the physical world.', href:'/robots/', status:'Live now'}
];
---
<Base title="Technology | Better Than Awesome" description="Discover robots, batteries, mobility, smart home technology, AI, electronics and the systems that amplify what people can do.">
<header class="tech-head"><a href="/">← Better Than Awesome</a><div class="eyebrow">Technology discovery</div><h1>Robots are only part of the machine.</h1><p>Better Than Awesome follows the technologies that connect to one another in real life. A robot needs power. An electric vehicle needs charging. A smart home needs sensors. AI needs hardware. Useful recommendations should follow those relationships instead of scattering random affiliate links across a page.</p></header>
<section class="lanes">{lanes.map(l => <article><span>{l.kicker}</span><h2>{l.title}</h2><p>{l.body}</p><div class="status">{l.status}</div>{l.href && <a href={l.href}>Explore now →</a>}</article>)}</section>
<section class="money"><div><div class="eyebrow">How BTA makes money</div><h2>Useful first. Commercial second.</h2><p>Where a relevant company offers an affiliate or referral relationship, Better Than Awesome can earn from a qualified purchase or lead. Commercial relationships should be disclosed, and they do not turn a product into a recommendation by themselves.</p></div><a class="btn blue" href="/coverage/">See what we cover</a></section>
<section class="connections"><div class="eyebrow">Connected discovery</div><h2>One question should lead naturally to the next.</h2><div class="connection-grid"><article><strong>Buying a robot?</strong><p>Consider power, networking, sensors, integration, safety, maintenance and financing.</p></article><article><strong>Buying an EV?</strong><p>Consider charging, home energy, accessories, monitoring and mobility technology.</p></article><article><strong>Building a smart home?</strong><p>Consider security, lighting, cleaning, energy, interoperability and privacy.</p></article></div></section>
</Base>
<style>
.tech-head{padding:42px 0 64px;max-width:1080px}.tech-head>a{display:inline-block;margin-bottom:52px;text-decoration:none;font-weight:800;color:var(--muted)}.tech-head h1{font-size:clamp(60px,9vw,126px);line-height:.86;letter-spacing:-.07em;margin:12px 0 28px;max-width:9ch}.tech-head p{font-size:21px;line-height:1.55;max-width:860px}.lanes{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.lanes article{min-height:330px;padding:26px;border:1px solid var(--line);border-radius:22px;background:white;display:flex;flex-direction:column}.lanes article>span{font-size:11px;text-transform:uppercase;letter-spacing:.13em;font-weight:900;color:var(--bta-blue)}.lanes h2{font-size:39px;line-height:.95;letter-spacing:-.05em;margin:16px 0 10px}.lanes p{line-height:1.55;color:var(--muted)}.lanes .status{margin-top:auto;padding-top:20px;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.08em}.lanes a{font-weight:900;margin-top:8px}.money{margin:80px 0 30px;padding:38px;border-radius:26px;background:#0b0d12;color:white;display:grid;grid-template-columns:1fr auto;gap:30px;align-items:end}.money h2{font-size:clamp(40px,6vw,72px);line-height:.94;letter-spacing:-.055em;margin:9px 0}.money p{max-width:760px;line-height:1.55;color:#c7ccd7}.connections{padding:60px 0}.connections h2{font-size:48px;letter-spacing:-.05em;margin:8px 0 25px}.connection-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.connection-grid article{padding:22px;border-top:2px solid var(--ink)}.connection-grid strong{font-size:24px}.connection-grid p{line-height:1.5;color:var(--muted)}@media(max-width:800px){.lanes,.connection-grid,.money{grid-template-columns:1fr}.tech-head h1{font-size:60px}}
</style>