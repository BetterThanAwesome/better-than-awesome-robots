---
import Base from '../../layouts/Base.astro';

const categories = [
  {slug:'humanoids', title:'Humanoid Robots', label:'Humanoids', copy:'Bipedal, wheeled and human-presenting robots for research, service and industrial experimentation.', cls:'blue'},
  {slug:'quadrupeds', title:'Robot Dogs & Quadrupeds', label:'Quadrupeds', copy:'Legged and wheel-legged platforms for mobility, inspection, research and terrain.', cls:'dark'},
  {slug:'cleaning', title:'Cleaning Robots', label:'Commercial cleaning', copy:'Autonomous floor care built around square footage, labor and repeatable facility work.', cls:'lime'},
  {slug:'delivery', title:'Delivery & Hospitality Robots', label:'Service automation', copy:'Indoor delivery robots for hotels, restaurants, offices and customer-facing operations.', cls:'red'},
  {slug:'warehouse', title:'Warehouse & Material Handling', label:'Logistics', copy:'AMRs and material movers for pallets, carts, supplies and repetitive internal transport.', cls:'navy'},
  {slug:'safety', title:'Public Safety Robots', label:'Emergency response', copy:'Firefighting and hazardous-environment robotics designed to keep people farther from danger.', cls:'orange'},
  {slug:'healthcare', title:'Healthcare & Medical Robots', label:'Healthcare robotics', copy:'Therapy, rehabilitation, hospital operations and assistive robotic systems.', cls:'teal'},
  {slug:'companions', title:'Companion & Social Robots', label:'Human interaction', copy:'Care-centric, multilingual and social robots designed around people rather than industrial throughput.', cls:'purple'}
];
---
<Base title="Robot Categories | Better Than Awesome" description="Explore Better Than Awesome robot categories by the job you need done.">
  <header class="site-header">
    <a class="brand" href="/"><span class="brand-mark">BTA</span><span>Better Than Awesome</span><span class="brand-sub">Robots</span></a>
    <nav class="nav"><a href="/">Home</a><a href="/robots/">All robots</a><a href="/blog/">Articles</a></nav>
  </header>
  <section class="category-index-hero">
    <div class="eyebrow">Shop by job</div>
    <h1>What do you want a robot to do?</h1>
    <p>Start with the work, then look at machines. That is usually a better buying process than starting with whichever robot is currently going viral.</p>
  </section>
  <section class="category-index-grid">
    {categories.map(category => (
      <a class={'category-tile ' + category.cls} href={'/categories/' + category.slug + '/'}>
        <span>{category.label}</span>
        <strong>{category.title}</strong>
        <p>{category.copy}</p>
        <b>Explore category →</b>
      </a>
    ))}
  </section>
</Base>
<style>
.category-index-hero{padding:60px 0 30px;max-width:980px}.category-index-hero h1{font-size:clamp(58px,8vw,108px);line-height:.87;letter-spacing:-.07em;margin:12px 0 18px;max-width:9ch}.category-index-hero p{font-size:20px;line-height:1.5;max-width:740px}
.category-index-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin:16px 0 48px}.category-tile{min-height:330px;padding:26px;border-radius:24px;color:white;text-decoration:none;display:flex;flex-direction:column;justify-content:flex-end}
.category-tile span{font-size:11px;text-transform:uppercase;letter-spacing:.13em;font-weight:900;opacity:.8}.category-tile strong{font-size:38px;line-height:.95;letter-spacing:-.045em;margin-top:8px;max-width:11ch}.category-tile p{max-width:46ch;line-height:1.45;color:rgba(255,255,255,.82)}.category-tile b{font-size:12px;margin-top:10px}
.category-tile.blue{background:linear-gradient(135deg,#071326,#164ca3)}.category-tile.dark{background:linear-gradient(135deg,#08090c,#30343b)}.category-tile.lime{background:linear-gradient(135deg,#18321a,#7fb72a)}.category-tile.red{background:linear-gradient(135deg,#32090d,#a61927)}.category-tile.navy{background:linear-gradient(135deg,#071321,#123f62)}.category-tile.orange{background:linear-gradient(135deg,#3d1805,#b55311)}.category-tile.teal{background:linear-gradient(135deg,#073b3a,#148b87)}.category-tile.purple{background:linear-gradient(135deg,#24104a,#7441b8)}
@media(max-width:760px){.category-index-grid{grid-template-columns:1fr}}
</style>