---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import site from '../content/site.json';
const robots=(await getCollection('robots')).filter(r=>r.data.status==='published').sort((a,b)=>Number(b.data.featured)-Number(a.data.featured));
const pictured=robots.filter(r=>Boolean(r.data.image));
const featured=pictured.slice(0,9);
const hero=pictured.slice(0,3);
---
<Base title="Better Than Awesome | Robots, Machines and Technology That Expand What People Can Do" description="Discover robots and connected technology by the job they do, learn the history of human and machine collaboration, and find regional buying paths.">
<header class="site-header"><a class="brand" href="/" aria-label="Better Than Awesome home"><span class="brand-mark">BTA</span><span>Better Than Awesome</span></a><nav class="nav" aria-label="Primary navigation"><a href="#robots">Robots</a><a href="/technology/">Technology</a><a href="/human-machine/">Human + Machine</a><a href="/blog/">Learn</a><a href="#organizations">Organizations</a><a href="/international/">International</a></nav></header>
<main>
<section class="hero"><div class="hero-copy"><div class="eyebrow">Robots + technology for actual humans</div><h1>Find the machine that helps you do more.</h1><p>Start with what you are trying to accomplish. Better Than Awesome connects robots, machines, power, mobility and emerging technology to practical uses, real products and regional buying paths.</p><div class="actions"><a class="btn blue" href="#robots">Explore robots</a><a class="btn secondary" href="/technology/">Explore technology</a></div></div><div class="hero-gallery" aria-label="Featured robots">{hero.map((robot,i)=><a class:list={["hero-shot",i===0&&"hero-shot-main"]} href={`/robots/${robot.slug}/`}><img src={robot.data.image} alt={robot.data.title}/><span><small>{robot.data.category}</small>{robot.data.title}</span></a>)}</div></section>
<section class="promise"><div><strong>Start with the job.</strong><span>Not the hype cycle.</span></div><div><strong>Connect the technology.</strong><span>Robots are part of a larger system.</span></div><div><strong>Know where facts came from.</strong><span>Claims, sources and seller information stay distinguishable.</span></div></section>
<section class="section-block"><div class="section-head"><div><div class="eyebrow">Choose your path</div><h2>What are you here to do?</h2></div><p>Different visitors need different doors. Get to the useful part quickly.</p></div><div class="path-grid"><a class="path-card image" href="/categories/humanoids/"><img src="/media/robots/ubtech-uworld-u1-ultra-female.webp" alt="Humanoid robot"/><span>Explore humanoids</span><strong>Robots built to work and interact in human environments.</strong></a><a class="path-card image" href="/categories/warehouse/"><img src="/media/robots/pudu-mp2000.webp" alt="Warehouse robot"/><span>Automate work</span><strong>Logistics, movement, cleaning and repetitive physical tasks.</strong></a><a class="path-card image" href="/categories/cleaning/"><img src="/media/robots/pudu-bg1-pro.webp" alt="Commercial cleaning robot"/><span>Buy by job</span><strong>Start with the outcome, then compare machines that can deliver it.</strong></a><a class="path-card dark" href="/technology/"><span>Beyond robots</span><strong>Power, batteries, mobility, AI, smart homes, tools and connected systems.</strong><b>Explore technology →</b></a><a class="path-card violet" href="/human-machine/"><span>Human + Machine</span><strong>How tools became machines, machines became robots, and collaboration became the point.</strong><b>Explore the timeline →</b></a><a class="path-card lime" href="/international/"><span>International</span><strong>Regional language, availability, procurement and editorial context without copy paste localization.</strong><b>Choose an edition →</b></a></div></section>
<section id="robots" class="section-block"><div class="section-head"><div><div class="eyebrow">Robot discovery</div><h2>See the machines.</h2></div><p>Real imagery where we have verified assets, useful context everywhere, and a seller handoff when you are ready.</p></div><div class="robot-grid">{featured.map(robot=><article class="robot-card visual-card"><a href={`/robots/${robot.slug}/`}><img class="robot-image" src={robot.data.image} alt={robot.data.title}/></a><div class="robot-card-body"><div class="meta">{robot.data.category} · {robot.data.manufacturer}</div><h3>{robot.data.title}</h3>{robot.data.hook&&<p>{robot.data.hook}</p>}<div class="card-actions"><a class="btn blue" href={`/robots/${robot.slug}/`}>Explore robot</a>{robot.data.seller_url&&<a class="text-link" href={robot.data.seller_url} rel="sponsored nofollow">Seller listing →</a>}</div></div></article>)}</div><div class="center"><a class="btn secondary" href="/robots/">Open the full robot catalog</a></div></section>
<section class="ecosystem"><div class="ecosystem-copy"><div class="eyebrow">The connected machine</div><h2>Robots are not the whole deal.</h2><p>A robot may need power, charging, sensors, networking, software, cameras, tools, training or mobility infrastructure. Better Than Awesome is building the useful connections between those systems so product discovery can lead naturally to the rest of the solution.</p><a class="btn blue" href="/technology/">Explore the technology map</a></div><div class="ecosystem-map"><a href="/technology/">Power + Batteries</a><a href="/technology/">Cars + Mobility</a><a href="/agents/">AI + Computing</a><a href="/technology/">Smart Home</a><a href="/technology/">Tools + Making</a><a href="/robots/">Robots</a></div></section>
<section class="story-band"><div><div class="eyebrow">Human + Machine</div><h2>The future is not just automation. It is amplification.</h2><p>Explore the long history of people building tools that extend strength, precision, memory, mobility and imagination, from early automata to embodied AI.</p></div><a class="btn secondary" href="/human-machine/">Explore the timeline</a></section>
<section id="organizations" class="org-banner"><div><div class="eyebrow">Government · hospitals · campuses · warehouses · organizations</div><h2>Need procurement language instead of robot enthusiasm?</h2><p>Use the institutional path for requirements, evaluation criteria and quote planning.</p></div><a class="btn secondary" href="/tests/procurement/">Open procurement interface</a></section>
<section class="region-shop"><div><div class="eyebrow">Buy in your region</div><h2>Useful globally, relevant locally.</h2><p>Regional editions and seller pathways keep language, availability and buying context meaningful.</p></div><div class="region-links"><a href={site.us_referral_url} rel="sponsored nofollow"><strong>USA</strong><span>RobotsUSA →</span></a><a href={site.international_referral_url} rel="sponsored nofollow"><strong>International</strong><span>RobotsInternational →</span></a><a href={site.asia_referral_url} rel="sponsored nofollow"><strong>Asia</strong><span>RobotsAsia →</span></a><a href={site.europe_referral_url} rel="sponsored nofollow"><strong>Europe</strong><span>RobotsEuropa →</span></a><a href={site.africa_referral_url} rel="sponsored nofollow"><strong>Africa</strong><span>RobotsAfrica →</span></a></div></section>
</main></Base>
<style>
.hero{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:center;padding:58px 0 32px}.hero h1{font-size:clamp(58px,7.8vw,110px);line-height:.86;letter-spacing:-.07em;margin:14px 0 22px;max-width:8ch}.hero-copy p{font-size:20px;line-height:1.5;max-width:650px}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:24px}.hero-gallery{display:grid;grid-template-columns:1.2fr .8fr;grid-template-rows:1fr 1fr;gap:12px;height:570px}.hero-shot{position:relative;background:#0c111c;border-radius:22px;overflow:hidden;border:1px solid #1d2940}.hero-shot-main{grid-row:1/3}.hero-shot img{width:100%;height:100%;object-fit:contain;padding:20px;filter:drop-shadow(0 18px 25px rgba(0,0,0,.28))}.hero-shot span{position:absolute;left:12px;right:12px;bottom:12px;background:rgba(0,0,0,.82);color:#fff;padding:10px 12px;border-radius:12px;font-weight:900}.hero-shot small{display:block;color:#9db8ff;text-transform:uppercase;letter-spacing:.1em;font-size:9px;margin-bottom:3px}.promise{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);border-radius:18px;overflow:hidden;margin:18px 0 72px}.promise div{padding:18px;background:#fff;border-right:1px solid var(--line)}.promise div:last-child{border:0}.promise strong,.promise span{display:block}.promise span{font-size:13px;color:var(--muted);margin-top:4px}.section-block{margin:72px 0}.path-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.path-card{min-height:330px;border-radius:20px;overflow:hidden;text-decoration:none;padding:22px;display:flex;flex-direction:column;justify-content:flex-end;position:relative}.path-card.image{background:#0c111c;color:#fff}.path-card.image img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;padding:15px;opacity:.72}.path-card.image:after{content:'';position:absolute;inset:35% 0 0;background:linear-gradient(transparent,#080a0f)}.path-card span,.path-card strong,.path-card b{position:relative;z-index:2}.path-card span{text-transform:uppercase;letter-spacing:.1em;font-size:10px;font-weight:900}.path-card strong{font-size:27px;line-height:1.05;letter-spacing:-.04em;margin-top:8px}.path-card b{margin-top:18px;font-size:13px}.path-card.dark{background:#10131b;color:#fff}.path-card.violet{background:#6237ff;color:#fff}.path-card.lime{background:#d8ff45;color:#111}.robot-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.visual-card .robot-image{height:280px;background:#0c111c;object-fit:contain;padding:18px}.center{text-align:center;margin-top:22px}.ecosystem{display:grid;grid-template-columns:1.1fr .9fr;gap:35px;background:#0a0d13;color:#fff;border-radius:26px;padding:42px;margin:90px 0}.ecosystem h2,.story-band h2{font-size:clamp(42px,6vw,74px);line-height:.94;letter-spacing:-.055em;margin:10px 0}.ecosystem p{color:#c7cdd8;line-height:1.6;font-size:18px}.ecosystem-map{display:grid;grid-template-columns:1fr 1fr;gap:8px}.ecosystem-map a{background:#151c29;border:1px solid #28344a;color:#fff;text-decoration:none;padding:20px;border-radius:14px;font-weight:900;display:flex;align-items:flex-end;min-height:105px}.story-band{display:grid;grid-template-columns:1fr auto;gap:30px;align-items:end;background:#6237ff;color:#fff;padding:42px;border-radius:26px;margin:60px 0}.story-band p{font-size:18px;line-height:1.55;max-width:780px}.region-shop{margin:60px 0}.region-links{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:20px}.region-links a{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px;text-decoration:none}.region-links strong,.region-links span{display:block}.region-links span{font-size:12px;color:var(--muted);margin-top:5px}@media(max-width:850px){.hero,.ecosystem,.story-band{grid-template-columns:1fr}.hero-gallery{height:500px}.path-grid,.robot-grid{grid-template-columns:1fr 1fr}.region-links{grid-template-columns:1fr 1fr}.promise{grid-template-columns:1fr}.promise div{border-right:0;border-bottom:1px solid var(--line)}}@media(max-width:560px){.path-grid,.robot-grid{grid-template-columns:1fr}.hero-gallery{height:620px;grid-template-columns:1fr;grid-template-rows:2fr 1fr 1fr}.hero-shot-main{grid-row:auto}.region-links{grid-template-columns:1fr}}
</style>