---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const robots = (await getCollection('robots'))
  .filter(r => r.data.status === 'published')
  .sort((a,b) => Number(b.data.featured) - Number(a.data.featured));

const categories = [...new Set(robots.map(r => r.data.category))];
---
<Base title="Robots You Can Actually Buy | Better Than Awesome" description="A growing Better Than Awesome catalog of robots, practical use cases, buyer guides, and regional seller links.">
  <header class="site-header">
    <a class="brand" href="/">
      <span class="brand-mark">BTA</span>
      <span>Better Than Awesome</span>
      <span class="brand-sub">Robots</span>
    </a>
    <nav class="nav">
      <a href="#robots">Robots</a>
      <a href="/blog/">Articles</a>
      <a href="#organizations">For organizations</a>
      <a href="/tests/procurement/">Test 2</a>\n      <a href="/tests/modernist/">Test 3</a>
    </nav>
  </header>

  <section class="market-hero">
    <div>
      <div class="eyebrow">Robots, minus the bullshit</div>
      <h1>Find the robot that actually does the thing.</h1>
      <p class="lede">We sort through robots by what they can do, who they are for, what still needs verification, and where you can actually buy or quote them.</p>
    </div>
    <aside class="hero-panel">
      <span class="lime"></span>
      <strong>Start with the job.<br/>Then pick the robot.</strong>
      <p>Cleaning, warehouse movement, humanoid interaction, inspection, public safety, education, healthcare, home use, and a lot more as this catalog grows.</p>
    </aside>
  </section>

  <section id="robots">
    <div class="search-shell">
      <strong>Search</strong>
      <input id="robotSearch" type="search" placeholder="robot, job, category, manufacturer..." aria-label="Search robot catalog" />
    </div>

    <div class="filter-row" aria-label="Robot category filters">
      <button class="filter-chip active" data-filter="all">All robots</button>
      {categories.map(category => <button class="filter-chip" data-filter={category.toLowerCase()}>{category}</button>)}
    </div>

    <div class="section-head">
      <div>
        <div class="eyebrow">Catalog preview</div>
        <h2>Robots you can actually buy</h2>
      </div>
      <p>This is the beginning, not the finished catalog. We are adding products, prices, regional availability, sources, videos, and buyer context as we verify them.</p>
    </div>

    <div class="grid" id="robotGrid">
      {robots.map(robot => (
        <article
          class="robot-card"
          data-robot-card
          data-category={robot.data.category.toLowerCase()}
          data-search={[robot.data.title, robot.data.category, robot.data.manufacturer, robot.data.buyer, robot.data.problem, robot.data.tags?.join(' ')].filter(Boolean).join(' ').toLowerCase()}
        >
          {robot.data.image && <img class="robot-image" src={robot.data.image} alt={robot.data.title} />}
          <div class="robot-card-body">
            <div class="meta">{robot.data.category} · {robot.data.manufacturer}</div>
            <h3>{robot.data.title}</h3>
            {robot.data.hook && <p>{robot.data.hook}</p>}
            {robot.data.buyer && <p class="robot-buyer"><strong>Good fit to investigate:</strong> {robot.data.buyer}</p>}
            <div class="card-actions">
              <a class="btn blue" href={`/robots/${robot.slug}/`}>Explore robot</a>
            </div>
          </div>
          <div class="seller-bridge">
            <span><strong>Buying handoff</strong><br/>Regional seller and current availability</span>
            {robot.data.affiliate_url && <a href={robot.data.affiliate_url} rel="sponsored nofollow">RobotsUSA →</a>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="handoff">
    <div class="handoff-copy">
      <div class="eyebrow">The handoff</div>
      <h2>Better Than Awesome helps you figure out what to buy.</h2>
      <p>When you are ready to price, quote, finance, or order, the interface deliberately becomes more transactional and hands you to the regional seller. Different site, same decision path.</p>
      <a class="btn secondary" href="https://www.robotsusa.com/partners/ref/1D754048" rel="sponsored nofollow">Browse the USA seller</a>
    </div>
    <div class="handoff-seller">
      <div class="small">AFFILIATE PARTNER HANDOFF</div>
      <strong>Ready to buy?<br/>Now it gets boring on purpose.</strong>
      <div>Current prices, quote requests, availability, shipping, and checkout live with the seller.</div>
    </div>
  </section>

  <section id="organizations" class="org-banner">
    <div>
      <div class="eyebrow">Government · hospitals · campuses · warehouses · organizations</div>
      <h2 style="margin:6px 0 0">Need procurement language instead of robot enthusiasm?</h2>
      <p>We are building a deliberately plain institutional buying interface at buyrobots.betterthanawesome.com.</p>
    </div>
    <a class="btn secondary" href="/tests/procurement/">Open procurement Test 2</a>
  </section>

  <section class="section-head">
    <div>
      <div class="eyebrow">Editorial layer</div>
      <h2>Not just product listings</h2>
    </div>
    <p>Videos, interviews, buyer guides, experiments, surveys, social content, and our own increasingly opinionated questions about where robots are actually useful.</p>
  </section>

  <section class="editorial-grid">
    <article class="editorial-card">
      <div class="meta">Buyer guide</div>
      <h3>Before you buy a robot, start with the job.</h3>
      <p>Define the repeated work first. Then evaluate autonomy, environment, staffing, safety, maintenance, service, and actual economic value.</p>
      <a class="btn blue" href="/blog/">Read robot articles</a>
    </article>
    <article class="editorial-card">
      <div class="meta">Aesthetic experiment 03</div>
      <h3>The severe Helvetica one is staying.</h3>
      <p>The stripped editorial version now lives permanently as a design test instead of disappearing when this marketplace changes.</p>
      <a class="btn secondary" href="/tests/modernist/">Open Test 3</a>
    </article>
  </section>

  <script is:inline>
    const search = document.querySelector('#robotSearch');
    const cards = [...document.querySelectorAll('[data-robot-card]')];
    const chips = [...document.querySelectorAll('[data-filter]')];
    let activeFilter = 'all';

    function applyFilters() {
      const q = (search?.value || '').trim().toLowerCase();
      cards.forEach(card => {
        const matchesSearch = !q || card.dataset.search.includes(q);
        const matchesCategory = activeFilter === 'all' || card.dataset.category === activeFilter;
        card.style.display = matchesSearch && matchesCategory ? '' : 'none';
      });
    }

    search?.addEventListener('input', applyFilters);
    chips.forEach(chip => chip.addEventListener('click', () => {
      activeFilter = chip.dataset.filter;
      chips.forEach(c => c.classList.toggle('active', c === chip));
      applyFilters();
    }));
  </script>
</Base>
