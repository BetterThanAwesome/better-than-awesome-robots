---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import site from '../content/site.json';
const robots=(await getCollection('robots')).filter(r=>r.data.status==='published').sort((a,b)=>Number(b.data.featured)-Number(a.data.featured));
const bySlug = (slug) => robots.find(r => r.slug === slug);
const hero = ['farmdroid-fd20','dji-matrice-4t','deyee-polyenergy-king-dy-h3'].map(bySlug).filter(Boolean);
const segments = [
  { slug:'dji-matrice-4t', label:'Fire + emergency response', summary:'Thermal aerial reconnaissance, hotspot detection and rapid situational awareness.' },
  { slug:'deyee-polyenergy-king-dy-h3', label:'Healthcare + rehabilitation', summary:'Therapy and rehabilitation systems where evidence, safety and clinical workflow matter.' },
  { slug:'farmdroid-fd20', label:'Farm + agriculture', summary:'Autonomous seeding, weeding and crop work, organized around acres, crops and field conditions.' },
  { slug:'keenon-s100', label:'Warehouse + logistics', summary:'Move carts, loads and supplies through repeatable indoor routes.' },
  { slug:'pudu-bg1-pro', label:'Cleaning + facilities', summary:'Commercial floor care judged by square footage, uptime, labor and maintenance.' },
  { slug:'pudu-bellabot-pro', label:'Hospitality + delivery', summary:'Indoor delivery for restaurants, hotels, venues and service operations.' },
  { slug:'unitree-go2', label:'Inspection + terrain', summary:'Legged mobility for research, inspection and places where wheels are limiting.' },
  { slug:'fourier-gr3-care-bot', label:'Care + companion', summary:'Human-facing robots where trust, privacy and meaningful support matter.' },
  { slug:'unitree-r1-basic', label:'Research + embodied AI', summary:'Humanoid research stays in the catalog, but it is one job family among many.' }
].map(item => ({ ...item, robot: bySlug(item.slug) })).filter(item => item.robot);
---
<Base title="Better Than Awesome | Robots, Machines and Technology That Expand What People Can Do" description="Discover robots and connected technology by the job they do, learn the history of human and machine collaboration, and find regional buying paths.">
<header class="site-header"><a class="brand" href="/" aria-label="Better Than Awesome home"><span class="brand-mark">BTA</span><span>Better Than Awesome</span></a><nav class="nav" aria-label="Primary navigation"><a href="/robots/">Robots</a><a href="/technology/">Technology</a><a href="/human-machine/">Human + Machine</a><a href="/blog/">Learn</a><a href="/organizations/">Organizations</a><a href="/international/">International</a></nav></header>
<nav class="quick-nav" aria-label="Quick access">
  <a href="/robots/">Explore robots</a>
  <a href="#paths">Browse by job</a>
  <a href="/technology/">Technology</a>
  <a href="/human-machine/">Human + Machine</a>
  <a href="/international/">International</a>
</nav>
<main>
<section class="hero"><div class="hero-copy"><div class="eyebrow">Robots + technology for actual humans</div><h1>Find the machine that helps you do more.</h1><p>Start with the work. Farm, fire response, healthcare, logistics, cleaning, hospitality, inspection and research all need different machines. Better Than Awesome helps you shop by the job instead of by the hype.</p><div class="actions"><a class="btn blue" href="#segments">Shop by real-world work</a><a class="btn secondary" href="/robots/">Open the full catalog</a></div></div><div class="hero-gallery" aria-label="Featured real-world robots">{hero.map((robot,i)=><a class:list={["hero-shot",i===0&&"hero-shot-main"]} href={`/robots/${robot.slug}/`}>{robot.data.image ? <img src={robot.data.image} alt={robot.data.title}/> : <div class="hero-fallback"><small>{robot.data.category}</small><strong>{robot.data.title}</strong></div>}<span><small>{robot.data.category}</small>{robot.data.title}</span></a>)}</div></section>
<section class="promise"><div><strong>Start with the job.</strong><span>Not the hype cycle.</span></div><div><strong>Connect the technology.</strong><span>Robots are part of a larger system.</span></div><div><strong>Know where facts came from.</strong><span>Claims, sources and seller information stay distinguishable.</span></div></section>
<section id="paths" class="section-block"><div class="section-head"><div><div class="eyebrow">Choose your path</div><h2>What are you here to do?</h2></div><p>Different visitors need different doors. Get to the useful part quickly.</p></div><div class="path-grid"><a class="path-card image" href="/categories/humanoids/">{hero[1] && <img src={hero[1].data.image} alt={hero[1].data.title}/>}<span>Explore humanoids</span><strong>Human-scale machines for research, interaction and embodied AI.</strong></a><a class="path-card image" href="/categories/quadrupeds/">{hero[0] && <img src={hero[0].data.image} alt={hero[0].data.title}/>}<span>Explore quadrupeds</span><strong>Legged robots for mobility, inspection, research and hard-to-reach places.</strong></a><a class="path-card image" href="/robots/">{hero[2] && <img src={hero[2].data.image} alt={hero[2].data.title}/>}<span>See real machines</span><strong>Start with working product records, then follow the task, seller and buying context.</strong></a><a class="path-card dark" href="/technology/"><span>Beyond robots</span><strong>Power, batteries, mobility, AI, smart homes, tools and connected systems.</strong><b>Explore technology →</b></a><a class="path-card violet" href="/human-machine/"><span>Human + Machine</span><strong>How tools became machines, machines became robots, and collaboration became the point.</strong><b>Explore the timeline →</b></a><a class="path-card lime" href="/international/"><span>International</span><strong>Regional language, availability, procurement and editorial context without copy paste localization.</strong><b>Choose an edition →</b></a></div></section>
<section id="segments" class="section-block"><div class="section-head"><div><div class="eyebrow">Shop the catalog by real work</div><h2>One machine from every major lane.</h2></div><p>Public safety, medicine and agriculture come first here because robots are most useful when they solve a concrete problem.</p></div><div class="segment-grid">{segments.map(({label,summary,robot})=><article class="segment-card">{robot.data.image ? <a class="segment-media" href={`/robots/${robot.slug}/`}><img src={robot.data.image} alt={robot.data.title}/></a> : <a class="segment-media segment-fallback" href={`/robots/${robot.slug}/`}><span>{label}</span><strong>{robot.data.manufacturer || 'Robot'}</strong></a>}<div class="segment-body"><div class="meta">{label}</div><h3>{robot.data.title}</h3><p>{summary}</p><div class="segment-buy">{robot.data.price_usd ? <strong>{'$'+robot.data.price_usd.toLocaleString()}</strong> : <strong>Quote based</strong>}<span>{robot.data.purchase_mode === 'request_quote' ? 'Configure + request quote' : 'Compare + investigate'}</span></div><div class="card-actions"><a class="btn blue" href={`/robots/${robot.slug}/`}>Explore this machine</a>{robot.data.seller_url&&<a class="text-link" href={robot.data.seller_url} rel="sponsored nofollow">Seller / manufacturer →</a>}</div></div></article>)}</div><div class="center"><a class="btn secondary" href="/robots/">Open every robot in the catalog</a></div></section>
<section class="ecosystem"><div class="ecosystem-copy"><div class="eyebrow">The connected machine</div><h2>Robots are not the whole deal.</h2><p>A robot may need power, charging, sensors, networking, software, cameras, tools, training or mobility infrastructure. Better Than Awesome is building the useful connections between those systems so product discovery can lead naturally to the rest of the solution.</p><a class="btn blue" href="/technology/">Explore the technology map</a></div><div class="ecosystem-map"><a href="/technology/">Power + Batteries</a><a href="/technology/">Cars + Mobility</a><a href="/agents/">AI + Computing</a><a href="/technology/">Smart Home</a><a href="/technology/">Tools + Making</a><a href="/robots/">Robots</a></div></section>
<section class="story-band"><div><div class="eyebrow">Human + Machine</div><h2>The future is not just automation. It is amplification.</h2><p>Explore the long history of people building tools that extend strength, precision, memory, mobility and imagination, from early automata to embodied AI.</p></div><a class="btn secondary" href="/human-machine/">Explore the timeline</a></section>
<section id="organizations" class="org-banner"><div><div class="eyebrow">Government · hospitals · campuses · warehouses · organizations</div><h2>Need procurement language instead of robot enthusiasm?</h2><p>Use the institutional path for requirements, evaluation criteria and quote planning.</p></div><a class="btn secondary" href="/tests/procurement/">Open procurement interface</a></section>
<section class="region-shop"><div><div class="eyebrow">Buy in your region</div><h2>Useful globally, relevant locally.</h2><p>Regional editions and seller pathways keep language, availability and buying context meaningful.</p></div><div class="region-links"><a href={site.us_referral_url} rel="sponsored nofollow"><strong>USA</strong><span>RobotsUSA →</span></a><a href={site.international_referral_url} rel="sponsored nofollow"><strong>International</strong><span>RobotsInternational →</span></a><a href={site.asia_referral_url} rel="sponsored nofollow"><strong>Asia</strong><span>RobotsAsia →</span></a><a href={site.europe_referral_url} rel="sponsored nofollow"><strong>Europe</strong><span>RobotsEuropa →</span></a><a href={site.africa_referral_url} rel="sponsored nofollow"><strong>Africa</strong><span>RobotsAfrica →</span></a></div></section>
</main></Base>
<style>
.quick-nav{display:flex;gap:8px;overflow-x:auto;padding:12px 0 4px;scrollbar-width:none}.quick-nav::-webkit-scrollbar{display:none}.quick-nav a{flex:0 0 auto;text-decoration:none;border:1px solid var(--line);background:#fff;border-radius:999px;padding:9px 13px;font-size:12px;font-weight:900}.quick-nav a:hover{border-color:var(--ink);background:var(--ink);color:#fff}.hero{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:34px;align-items:center;padding:46px 0 32px}.hero h1{font-size:clamp(58px,7.8vw,110px);line-height:.86;letter-spacing:-.07em;margin:14px 0 22px;max-width:8ch}.hero-copy p{font-size:20px;line-height:1.5;max-width:650px}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:24px}.hero-gallery{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);grid-template-rows:1fr 1fr;gap:12px;min-height:520px;height:min(42vw,570px)}.hero-shot{position:relative;background:#0c111c;border-radius:22px;overflow:hidden;border:1px solid #1d2940}.hero-shot-main{grid-row:1/3}.hero-shot img{width:100%;height:100%;object-fit:cover;object-position:center;display:block;background:#0c111c;filter:saturate(.95) contrast(1.02)}.hero-fallback{height:100%;display:flex;flex-direction:column;justify-content:center;padding:28px;background:radial-gradient(circle at 70% 20%,#3157ff55,transparent 35%),#0c111c;color:#fff}.hero-fallback small{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:#9db8ff;font-weight:900}.hero-fallback strong{font-size:34px;line-height:.95;letter-spacing:-.05em;margin-top:8px}.hero-shot span{position:absolute;left:12px;right:12px;bottom:12px;background:rgba(0,0,0,.82);color:#fff;padding:10px 12px;border-radius:12px;font-weight:900}.hero-shot small{display:block;color:#9db8ff;text-transform:uppercase;letter-spacing:.1em;font-size:9px;margin-bottom:3px}.promise{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);border-radius:18px;overflow:hidden;margin:18px 0 72px}.promise div{padding:18px;background:#fff;border-right:1px solid var(--line)}.promise div:last-child{border:0}.promise strong,.promise span{display:block}.promise span{font-size:13px;color:var(--muted);margin-top:4px}.section-block{margin:72px 0}.path-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.path-card{min-height:330px;border-radius:20px;overflow:hidden;text-decoration:none;padding:22px;display:flex;flex-direction:column;justify-content:flex-end;position:relative}.path-card.image{background:#0c111c;color:#fff}.path-card.image img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;object-position:center;display:block;padding:10px;background:#0c111c;opacity:.9}.path-card.image:after{content:'';position:absolute;inset:35% 0 0;background:linear-gradient(transparent,#080a0f)}.path-card span,.path-card strong,.path-card b{position:relative;z-index:2}.path-card span{text-transform:uppercase;letter-spacing:.1em;font-size:10px;font-weight:900}.path-card strong{font-size:27px;line-height:1.05;letter-spacing:-.04em;margin-top:8px}.path-card b{margin-top:18px;font-size:13px}.path-card.dark{background:#10131b;color:#fff}.path-card.violet{background:#6237ff;color:#fff}.path-card.lime{background:#d8ff45;color:#111}.robot-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.visual-card .robot-image{height:280px;width:100%;display:block;background:#0c111c;object-fit:contain;object-position:center;padding:10px}.segment-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.segment-card{display:flex;flex-direction:column;min-height:100%;overflow:hidden;border:1px solid var(--line);border-radius:20px;background:#fff}.segment-media{display:block;height:250px;background:#0c111c;overflow:hidden;border-bottom:1px solid var(--line);text-decoration:none}.segment-media img{width:100%;height:100%;object-fit:cover;object-position:center;display:block}.segment-fallback{padding:22px;display:flex;flex-direction:column;justify-content:flex-end;background:radial-gradient(circle at 80% 20%,#3157ff66,transparent 30%),linear-gradient(145deg,#071321,#123f62);color:#fff}.segment-fallback span{font-size:10px;text-transform:uppercase;letter-spacing:.12em;font-weight:900;color:#9db8ff}.segment-fallback strong{font-size:34px;line-height:1;letter-spacing:-.045em;margin-top:7px}.segment-body{padding:18px;display:flex;flex-direction:column;flex:1}.segment-body h3{font-size:27px;letter-spacing:-.04em;line-height:1;margin:8px 0}.segment-body p{line-height:1.45;color:var(--muted)}.segment-buy{display:flex;justify-content:space-between;gap:12px;align-items:end;border-top:1px solid var(--line);padding-top:12px;margin-top:auto}.segment-buy strong{font-size:20px}.segment-buy span{font-size:11px;color:var(--muted);text-align:right}.segment-body .card-actions{margin-top:12px}.center{text-align:center;margin-top:22px}.ecosystem{display:grid;grid-template-columns:1.1fr .9fr;gap:35px;background:#0a0d13;color:#fff;border-radius:26px;padding:42px;margin:90px 0}.ecosystem h2,.story-band h2{font-size:clamp(42px,6vw,74px);line-height:.94;letter-spacing:-.055em;margin:10px 0}.ecosystem p{color:#c7cdd8;line-height:1.6;font-size:18px}.ecosystem-map{display:grid;grid-template-columns:1fr 1fr;gap:8px}.ecosystem-map a{background:#151c29;border:1px solid #28344a;color:#fff;text-decoration:none;padding:20px;border-radius:14px;font-weight:900;display:flex;align-items:flex-end;min-height:105px}.story-band{display:grid;grid-template-columns:1fr auto;gap:30px;align-items:end;background:#6237ff;color:#fff;padding:42px;border-radius:26px;margin:60px 0}.story-band p{font-size:18px;line-height:1.55;max-width:780px}.region-shop{margin:60px 0}.region-links{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:20px}.region-links a{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px;text-decoration:none}.region-links strong,.region-links span{display:block}.region-links span{font-size:12px;color:var(--muted);margin-top:5px}@media(max-width:850px){.hero,.ecosystem,.story-band{grid-template-columns:1fr}.segment-grid{grid-template-columns:1fr 1fr}.hero{padding-top:34px}.hero-gallery{height:auto;min-height:0;grid-template-columns:1.15fr .85fr;grid-auto-rows:minmax(190px,32vw)}.hero-shot-main{grid-row:1/3}.path-grid,.robot-grid{grid-template-columns:1fr 1fr}.region-links{grid-template-columns:1fr 1fr}.promise{grid-template-columns:1fr}.promise div{border-right:0;border-bottom:1px solid var(--line)}}@media(max-width:560px){.quick-nav{margin-right:-28px;padding-right:28px}.path-grid,.robot-grid,.segment-grid{grid-template-columns:1fr}.hero-gallery{height:auto;grid-template-columns:1fr;grid-template-rows:none;gap:10px}.hero-shot,.hero-shot-main{grid-row:auto;aspect-ratio:16/10}.hero-shot img{padding:8px}.path-card{min-height:290px}.region-links{grid-template-columns:1fr}}
</style>