---
import Base from '../../layouts/Base.astro';

const milestones = [
  { era: 'Antiquity', year: 'c. 350 BCE', title: 'The self acting tool is imagined', body: 'In Politics, Aristotle considers a hypothetical world in which tools could perform their work on command. Better Than Awesome treats that old thought experiment as an early question about automation, labor and human time.', source: 'Aristotle, Politics, Book I' },
  { era: 'Mechanical imagination', year: '1206', title: 'Machines begin to perform sequences', body: 'Al Jazari documented programmable and automatic mechanical devices, showing that machines could be designed not merely as static tools, but as systems that carried out ordered actions.', source: 'Al Jazari, The Book of Knowledge of Ingenious Mechanical Devices' },
  { era: 'Industrialization', year: '1800s', title: 'Machines multiply physical power', body: 'Mechanization changes the scale of manufacturing, transportation and agriculture. The central question shifts from whether machines can do work to how people should organize work around machines.' },
  { era: 'Robots enter culture', year: '1920', title: 'The word robot arrives', body: 'Karel Čapek’s R.U.R. popularizes the word robot and places artificial workers inside a story about labor, power and what humans expect from the things they create.', source: 'Karel Čapek, R.U.R.' },
  { era: 'Automation', year: '1961', title: 'Industrial robots join the factory', body: 'Unimate begins industrial work at General Motors. Robots become operational equipment rather than primarily imagined machines.' },
  { era: 'Computing', year: 'Late 20th century', title: 'Machines amplify information work', body: 'Computers, networks and software extend human memory, calculation, communication and coordination. Machine amplification moves from muscles into knowledge work.' },
  { era: 'Collaboration', year: '2000s to 2020s', title: 'Robots move closer to people', body: 'Collaborative robots, autonomous mobile robots, surgical systems, rehabilitation devices, drones and increasingly capable service robots expand the environments where humans and machines work together.' },
  { era: 'Now', year: '2026', title: 'Embodied AI becomes a marketplace', body: 'Humanoids, quadrupeds, delivery robots, cleaning robots, warehouse systems and specialized machines are increasingly products organizations and individuals can evaluate, procure and deploy.' },
  { era: 'Next', year: 'The open question', title: 'What should machines amplify?', body: 'The useful future is not measured only by how much work a machine can remove. It is measured by what people can create, discover, protect, learn and accomplish with the capability machines add.' }
];
---

<Base title="Human + Machine | A History of Collaboration | Better Than Awesome" description="An evolving Better Than Awesome timeline about tools, automation, robots and the long human project of extending what people can do.">
  <header class="timeline-header">
    <a class="back" href="/">← Better Than Awesome</a>
    <div class="eyebrow">Human + Machine</div>
    <h1>We have always built things that let us do more.</h1>
    <p class="lede">A living history of tools, automation and robots, focused on collaboration rather than replacement. The question is not simply what machines can do. It is what people can do when machines expand our reach.</p>
    <div class="actions"><a class="btn blue" href="/robots/">Explore robots available now</a><a class="btn secondary" href="#timeline">Explore the timeline</a></div>
  </header>

  <section class="principles" aria-label="Human and machine principles">
    <article><strong>Amplify</strong><span>Use machines to extend human strength, precision, reach and imagination.</span></article>
    <article><strong>Collaborate</strong><span>Design workflows around what people and machines each do well.</span></article>
    <article><strong>Question</strong><span>Technology changes capability. People still decide what that capability is for.</span></article>
  </section>

  <section id="timeline" class="timeline">
    <div class="section-intro"><div class="eyebrow">The long view</div><h2>From imagined automation to machines you can buy.</h2><p>This timeline will grow as Better Than Awesome verifies primary sources, adds regional histories and connects historical ideas to contemporary machines.</p></div>
    <div class="timeline-list">
      {milestones.map((item, i) => (
        <article class="milestone">
          <div class="rail"><span>{String(i + 1).padStart(2,'0')}</span></div>
          <div class="date"><span>{item.era}</span><strong>{item.year}</strong></div>
          <div class="story"><h3>{item.title}</h3><p>{item.body}</p>{item.source && <small>Starting source: {item.source}. Source verification and expanded notes are part of the editorial build.</small>}</div>
        </article>
      ))}
    </div>
  </section>

  <section class="today">
    <div><div class="eyebrow">History meets procurement</div><h2>The timeline does not end in a museum.</h2><p>Better Than Awesome connects the history of machine capability to robots that can be investigated today, with buyer context, seller handoffs and practical categories organized around the job.</p></div>
    <a class="btn blue" href="/categories/">Find a robot by job</a>
  </section>

  <section class="editorial-note"><div class="eyebrow">Editorial standard</div><h2>A timeline should be useful, not decorative.</h2><p>As this experience expands, historical claims will be sourced, quotations will be distinguished from paraphrases, regional editions will add locally meaningful milestones, and uncertain claims will be identified rather than repeated as fact.</p></section>
</Base>

<style>
.timeline-header{padding:42px 0 58px;max-width:1100px}.back{display:inline-block;margin-bottom:52px;color:var(--muted);font-weight:800;text-decoration:none}.timeline-header h1{font-size:clamp(58px,9vw,126px);line-height:.86;letter-spacing:-.07em;margin:14px 0 26px;max-width:9ch}.lede{font-size:22px;line-height:1.5;max-width:800px}.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:28px}.principles{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);border-radius:22px;overflow:hidden;margin-bottom:96px}.principles article{padding:25px;border-right:1px solid var(--line)}.principles article:last-child{border-right:0}.principles strong,.principles span{display:block}.principles strong{font-size:28px;letter-spacing:-.04em}.principles span{color:var(--muted);line-height:1.45;margin-top:6px}.section-intro{display:grid;grid-template-columns:1fr 1fr;gap:25px;align-items:end;margin-bottom:34px}.section-intro h2{font-size:clamp(42px,6vw,76px);line-height:.95;letter-spacing:-.055em;margin:8px 0}.section-intro p{font-size:17px;line-height:1.55}.timeline-list{border-top:1px solid var(--line)}.milestone{display:grid;grid-template-columns:70px 220px 1fr;border-bottom:1px solid var(--line);min-height:230px}.rail{border-right:1px solid var(--line);padding:22px 0}.rail span{font-size:11px;font-weight:900}.date{padding:24px}.date span,.date strong{display:block}.date span{text-transform:uppercase;letter-spacing:.1em;font-size:10px;font-weight:900;color:var(--muted)}.date strong{font-size:22px;margin-top:5px}.story{padding:22px 24px 38px}.story h3{font-size:clamp(31px,4vw,56px);line-height:1;letter-spacing:-.05em;margin:0 0 12px}.story p{font-size:18px;line-height:1.55;max-width:820px}.story small{display:block;color:var(--muted);max-width:760px;line-height:1.45;margin-top:18px}.today{margin:100px 0 30px;padding:40px;border-radius:26px;background:#0b0d12;color:white;display:grid;grid-template-columns:1fr auto;gap:30px;align-items:end}.today h2{font-size:clamp(38px,5vw,70px);line-height:.95;letter-spacing:-.05em;margin:10px 0}.today p{max-width:760px;line-height:1.55;color:#c7ccd7}.editorial-note{padding:70px 0;max-width:850px}.editorial-note h2{font-size:42px;letter-spacing:-.045em;margin:10px 0}.editorial-note p{font-size:18px;line-height:1.55}@media(max-width:760px){.principles,.section-intro{grid-template-columns:1fr}.principles article{border-right:0;border-bottom:1px solid var(--line)}.milestone{grid-template-columns:42px 1fr}.date{grid-column:2;padding-bottom:0}.story{grid-column:2}.today{grid-template-columns:1fr}.timeline-header h1{font-size:58px}}
</style>