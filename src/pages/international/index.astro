---
import Base from '../../layouts/Base.astro';
const editions = [
  {region:'International', language:'English', href:'/international/', status:'Current fallback', note:'Global catalog, globally relevant editorial and international seller pathways.'},
  {region:'United States', language:'English', href:'/', status:'Live foundation', note:'US availability, procurement context and buyer pathways.'},
  {region:'Canada', language:'English + Français', href:'#', status:'Editorial build', note:'Canadian availability, pricing, procurement context and bilingual publishing.'},
  {region:'Europe', language:'Regional languages', href:'#', status:'Editorial build', note:'Country appropriate languages, European availability and locally relevant robotics context.'},
  {region:'Japan', language:'日本語 + English', href:'#', status:'Editorial build', note:'Japanese robotics history, manufacturers, terminology and market availability.'},
  {region:'Latin America', language:'Español + Português where relevant', href:'#', status:'Editorial build', note:'Regional availability, language, pricing context and local applications.'},
  {region:'Middle East', language:'العربية + English', href:'#', status:'Editorial build', note:'Regional procurement, infrastructure applications and market availability.'},
  {region:'Asia Pacific', language:'Regional languages + English', href:'#', status:'Editorial build', note:'Market specific editions built only where meaningful local content supports them.'}
];
---
<Base title="Better Than Awesome International | Robots and Technology" description="Choose a Better Than Awesome regional edition for locally relevant robot availability, language, procurement and editorial coverage.">
  <header class="intl-head"><a href="/">← Better Than Awesome</a><div class="eyebrow">International editions</div><h1>Global technology. Local context.</h1><p>Better Than Awesome will automatically make the most relevant edition easy to reach, while every visitor remains free to switch. Regional editions are published when there is meaningful local value, not merely another copy of the same page.</p></header>
  <section class="rule"><strong>Our publishing rule</strong><span>Shared facts can stay shared. Regional pages must add something that matters: language, availability, pricing, procurement, culture, history, applications, sources or local expertise.</span></section>
  <section class="edition-grid">{editions.map(e => <article><div class="status">{e.status}</div><h2>{e.region}</h2><strong>{e.language}</strong><p>{e.note}</p>{e.href !== '#' ? <a href={e.href}>Open edition →</a> : <span class="building">Building carefully, not mass publishing.</span>}</article>)}</section>
  <section class="machine-note"><div class="eyebrow">For humans, search engines and AI agents</div><h2>Every indexed page should deserve its URL.</h2><p>Regional editions will use stable URLs, language metadata, meaningful internal relationships, visible sourcing and structured facts that agree with the page people see. If an edition does not yet have enough regional value, visitors receive the International experience instead of a thin page manufactured for search traffic.</p></section>
</Base>
<style>
.intl-head{padding:42px 0 60px;max-width:1050px}.intl-head>a{display:inline-block;margin-bottom:50px;color:var(--muted);font-weight:800;text-decoration:none}.intl-head h1{font-size:clamp(60px,9vw,124px);line-height:.86;letter-spacing:-.07em;margin:12px 0 26px;max-width:8ch}.intl-head p{font-size:21px;line-height:1.55;max-width:850px}.rule{display:grid;grid-template-columns:220px 1fr;gap:28px;padding:25px;border:1px solid var(--line);border-radius:20px;margin-bottom:38px}.rule strong{font-size:24px;letter-spacing:-.03em}.rule span{line-height:1.55}.edition-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.edition-grid article{border:1px solid var(--line);border-radius:22px;padding:25px;min-height:270px;display:flex;flex-direction:column}.edition-grid h2{font-size:38px;letter-spacing:-.05em;margin:20px 0 4px}.edition-grid p{line-height:1.5;color:var(--muted)}.edition-grid a{margin-top:auto;font-weight:900}.status{font-size:10px;text-transform:uppercase;letter-spacing:.1em;font-weight:900}.building{margin-top:auto;font-size:12px;color:var(--muted);font-weight:800}.machine-note{margin:80px 0 30px;background:#0b0d12;color:white;padding:40px;border-radius:26px}.machine-note h2{font-size:clamp(40px,6vw,72px);line-height:.95;letter-spacing:-.055em;margin:10px 0}.machine-note p{max-width:850px;line-height:1.6;color:#c8ced8}@media(max-width:720px){.edition-grid,.rule{grid-template-columns:1fr}.intl-head h1{font-size:60px}}
</style>