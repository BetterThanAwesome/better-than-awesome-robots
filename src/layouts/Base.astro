---
import '../styles/global.css';
const { title = 'Better Than Awesome', description = 'Robots you can actually buy.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
</head>
<body>
  <main class="wrap">
    <slot />
    <footer><strong>Better Than Awesome</strong><br/>Robots, technology and things worth getting excited about.<br/><a href="mailto:hello@betterthanawesome.com">hello@betterthanawesome.com</a></footer>
  </main>
</body>
</html>
