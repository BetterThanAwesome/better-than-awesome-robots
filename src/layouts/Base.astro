---
import '../styles/global.css';
const {
  title = 'Better Than Awesome',
  description = 'Robots you can actually buy.',
  image,
  schema
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || 'https://betterthanawesome.com').toString();
const socialImage = image ? new URL(image, Astro.site || 'https://betterthanawesome.com').toString() : undefined;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {socialImage && <meta property="og:image" content={socialImage} />}
  <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {socialImage && <meta name="twitter:image" content={socialImage} />}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Better Than Awesome',
    url: 'https://betterthanawesome.com',
    description: 'Robot discovery, buyer guidance and affiliate marketplace navigation.'
  })}></script>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>}
</head>
<body>
  <main class="wrap">
    <slot />
    <footer><strong>Better Than Awesome</strong><br/>Robots, technology and things worth getting excited about.<br/><a href="mailto:hello@betterthanawesome.com">hello@betterthanawesome.com</a></footer>
  </main>
</body>
</html>
