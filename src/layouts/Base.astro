---
import '../styles/global.css';
import site from '../content/site.json';
const {
  title = 'Better Than Awesome',
  description = 'Robots you can actually buy.',
  image,
  schema
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || 'https://betterthanawesome.com').toString();
const socialImage = image ? new URL(image, Astro.site || 'https://betterthanawesome.com').toString() : undefined;
const isHome = Astro.url.pathname === '/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {socialImage && <meta property="og:image" content={socialImage} />}
  <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {socialImage && <meta name="twitter:image" content={socialImage} />}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Organization',
        '@id': 'https://betterthanawesome.com/#organization',
        name: 'Better Than Awesome',
        url: 'https://betterthanawesome.com',
        email: 'hello@betterthanawesome.com',
        description: 'Robot discovery, buyer guidance, technology editorial and affiliate marketplace navigation.'
      },
      {
        '@type': 'WebSite',
        '@id': 'https://betterthanawesome.com/#website',
        name: 'Better Than Awesome',
        url: 'https://betterthanawesome.com',
        publisher: { '@id': 'https://betterthanawesome.com/#organization' },
        description: 'Robot discovery, buyer guidance and affiliate marketplace navigation.'
      }
    ]
  })}></script>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>}
  <script is:inline define:vars={{ tracking: site.tracking || {} }}>
    window.__BTA_TRACKING__ = tracking;
  </script>
</head>
<body>
  <main class="wrap">
    {isHome && <aside class="home-visual-nav" aria-label="Explore Better Than Awesome">
      <a class="visual-nav-card visual-robot" href="/categories/humanoids/">
        <img src="/media/robots/ubtech-uworld-u1-ultra-female.webp" alt="Humanoid robot" />
        <span>Humanoids</span><strong>Meet the machines moving into the human world.</strong>
      </a>
      <a class="visual-nav-card visual-work" href="/categories/warehouse/">
        <img src="/media/robots/pudu-mp2000.webp" alt="Warehouse and logistics robot" />
        <span>Robots at work</span><strong>Machines built to move, clean, carry and collaborate.</strong>
      </a>
      <a class="visual-nav-card visual-clean" href="/categories/cleaning/">
        <img src="/media/robots/pudu-bg1-pro.webp" alt="Commercial cleaning robot" />
        <span>Buy by job</span><strong>Start with what you need done.</strong>
      </a>
      <a class="visual-nav-card visual-history" href="/human-machine/">
        <div class="visual-type">HUMAN<br/>+<br/>MACHINE</div>
        <span>History + ideas</span><strong>How machines amplify human ability.</strong>
      </a>
      <a class="visual-nav-card visual-world" href="/international/">
        <div class="visual-globe" aria-hidden="true">◎</div>
        <span>International</span><strong>Global technology with local context.</strong>
      </a>
    </aside>}
    <slot />
    <footer><strong>Better Than Awesome</strong><br/>Robots, technology and things worth getting excited about.<br/><a href="mailto:hello@betterthanawesome.com">hello@betterthanawesome.com</a> · <a href="/privacy/">Privacy & tracking</a></footer>
  </main>
  <script type="module" is:inline>
    import { initTracking } from '/tracking.js';
    initTracking(window.__BTA_TRACKING__ || {});
  </script>
</body>
</html>

<style>
.home-visual-nav{display:grid;grid-template-columns:1.4fr 1fr 1fr .9fr .9fr;gap:8px;padding:12px 0 2px}.visual-nav-card{position:relative;min-height:150px;border-radius:16px;overflow:hidden;background:#0a1020;color:white;text-decoration:none;padding:14px;display:flex;flex-direction:column;justify-content:flex-end;isolation:isolate}.visual-nav-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:radial-gradient(circle at 50% 40%,#254d98 0,#0c1d3e 45%,#070b13 100%);z-index:-2}.visual-nav-card:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.78),rgba(0,0,0,0) 65%);z-index:-1}.visual-nav-card span{font-size:10px;text-transform:uppercase;letter-spacing:.12em;font-weight:900;opacity:.8}.visual-nav-card strong{font-size:14px;line-height:1.12;margin-top:4px;max-width:22ch}.visual-history{background:linear-gradient(145deg,#160a2e,#5027a7 55%,#72cfff)}.visual-world{background:linear-gradient(145deg,#07182d,#124f77 55%,#77d8ff)}.visual-type{position:absolute;left:14px;top:12px;font-size:25px;font-weight:900;line-height:.7;letter-spacing:-.07em;opacity:.92}.visual-globe{position:absolute;right:10px;top:-28px;font-size:110px;line-height:1;opacity:.3}.visual-nav-card:hover{transform:translateY(-2px);transition:transform .16s ease}@media(max-width:900px){.home-visual-nav{grid-template-columns:repeat(2,1fr)}.visual-nav-card:first-child{grid-column:span 2}}@media(max-width:560px){.home-visual-nav{grid-template-columns:1fr}.visual-nav-card:first-child{grid-column:auto}.visual-nav-card{min-height:180px}}
</style>